# 火山方舟（豆包）API 配置 —— 复制为 .env 并填入真实值
# .env 已在 .gitignore 中，不会入库

# 火山方舟 API Key（在火山方舟控制台 → API Key 管理获取）
ARK_API_KEY=your_api_key_here

# 模型 endpoint ID（在火山方舟 → 在线推理 → 创建推理接入点后获得）
# 示例：doubao-seed-1.6 的接入点
ARK_MODEL=your_model_endpoint_id

# API Base URL（Coding Plan 专用路径）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
